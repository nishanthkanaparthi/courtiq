// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Match {
  id            String   @id @default(uuid())
  playerId      String
  coachId       String?
  opponentName  String
  format        String
  status        String
  startedAt     DateTime
  completedAt   DateTime?
  sets          Json
  currentSetIndex   Int
  currentGameIndex  Int
  winner        String?

  statEntries   StatEntry[]

  @@index([playerId])
}

model StatEntry {
  id           String   @id @default(uuid())
  matchId      String
  statTypeId   String
  outcome      String
  pointNumber  Int
  timestamp    DateTime

  match        Match    @relation(fields: [matchId], references: [id])

  @@index([matchId])
}